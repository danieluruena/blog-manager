{
  "name": "blog-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Administrador multi-blog para páginas web.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "predev": "npm run cf-typegen",
    "build": "tsc -b && vite build",
    "prebuild": "npm run cf-typegen",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "pretypecheck": "npm run cf-typegen",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"*.{json,jsonc,js,ts,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"*.{json,jsonc,js,ts,md}\"",
    "test": "vitest run",
    "pretest": "npm run cf-typegen",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "audit": "npm audit --omit=dev",
    "db:migrate:local": "wrangler d1 migrations apply blog-manager-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply blog-manager-db --remote",
    "db:seed": "wrangler d1 execute blog-manager-db --local --file=./migrations/seed.sql",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "user:create": "tsx scripts/create-admin.ts",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.0",
    "@cloudflare/vitest-plugin": "^1.8.4",
    "@cloudflare/workers-types": "^5.20261118.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.164.0"
  }
}
